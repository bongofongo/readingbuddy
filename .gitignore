/target

plan.md

/epubs

/database

/vault

anki.tsv

# Perf runs: per-run JSONL + summary, and the accumulated history.tsv. Machine-
# and terminal-specific, so a committed number would be misleading rather than
# useful — the trend only means anything against your own baseline.
/perf

.DS_Store

# Drop-in dir for the user's own real KOReader exports (never commit highlights).
/crates/engine/tests/fixtures/koreader/real/*
!/crates/engine/tests/fixtures/koreader/real/README.md
!/crates/engine/tests/fixtures/koreader/real/.gitkeep

# Tier-2 corpus: fetched Gutenberg epubs and the sidecars derived from them.
# corpus/manifest.json IS committed (ids + checksums); the payload is not.
/corpus/epub
/corpus/generated

# cargo-fuzz working state. `fuzz/seeds/` IS committed — a small hand-picked
# read-only set that tests/fuzz_seeds.rs replays on stable in PR CI.
/fuzz/target
/fuzz/corpus
/fuzz/artifacts

# The user's own calibre library / personal reading data. Never commit.
/personal_data

# Parallel-thread git worktrees: full checkouts plus their own target/ dirs.
/.claude/worktrees

