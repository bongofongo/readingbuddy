/target

plan.md

/epubs

/database

/vault

anki.tsv

# Perf runs: per-run JSONL + summary, and the accumulated history.tsv. Machine-
# and terminal-specific, so a committed number would be misleading rather than
# useful — the trend only means anything against your own baseline.
/perf

# `make dist` staging. The real archives are built by .github/workflows/release.yml
# and live on the GitHub release; this is only the local rehearsal of that.
/dist

.DS_Store

# Drop-in dir for the user's own real KOReader exports (never commit highlights).
/crates/engine/tests/fixtures/koreader/real/*
!/crates/engine/tests/fixtures/koreader/real/README.md
!/crates/engine/tests/fixtures/koreader/real/.gitkeep

# Tier-2 corpus: fetched Gutenberg epubs and the sidecars derived from them.
# corpus/manifest.json IS committed (ids + checksums); the payload is not.
/corpus/epub
/corpus/generated

# cargo-fuzz working state. `fuzz/seeds/` IS committed — a small hand-picked
# read-only set that tests/fuzz_seeds.rs replays on stable in PR CI.
/fuzz/target
/fuzz/corpus
/fuzz/artifacts

# The user's own calibre library / personal reading data. Never commit.
/personal_data

# Parallel-thread git worktrees: full checkouts plus their own target/ dirs.
/.claude/worktrees
/logs

# The seeded dev library `make dev-db` builds. Gitignored for the tier-2
# corpus's reason: it is large, it is a pure function of a seed, and a committed
# copy would be a second source of truth for what the dev library contains.
/dev-data

# The frontend's build state. `gui/src/lib/api/bindings.ts` IS committed — it is
# generated by `make ts` and CI's `make ts-check` diffs it, so a thread that
# cannot run cargo still reads current types. Everything here is machine state.
/gui/node_modules
/gui/build
/gui/.svelte-kit
/gui/src-tauri/target
/gui/src-tauri/gen

# Playwright's own output. `gui/tests/shots/` IS committed: a shot is a
# reviewable artifact, exactly as `make golden`'s import snapshots are, and it is
# what the screenshot-reviewer agent reads.
/gui/test-results
/gui/playwright-report
