{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "readingbuddy",
  "version": "0.1.0",
  "identifier": "com.readingbuddy.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "readingbuddy",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
